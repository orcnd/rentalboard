{
  "name": "rentalboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test:e2e": "node tests/browser.mjs",
    "cf:dev": "pywrangler dev --port 8790",
    "cf:deploy": "pywrangler deploy",
    "db:local": "wrangler d1 migrations apply rentalboard --local"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/vue": "^1.70.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.62.1",
    "typescript": "~5.9.0",
    "vite": "7.3.8",
    "vue-tsc": "^3.1.0",
    "wrangler": "4.159.0"
  }
}
