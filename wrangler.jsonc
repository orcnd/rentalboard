{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rentalboard",
  "main": "backend/worker.py",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rentalboard",
      "database_id": "b070e77e-c793-4d9d-b2be-7959f02a223c",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [
    { "pattern": "rentalboard.orcuncandan.com", "custom_domain": true },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://rentalboard.orcuncandan.com",
    "DEMO_ENABLED": "false",
    "RELEASE_ID": "rentalboard-0.1.0",
    "ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },
  "limits": {
    "cpu_ms": 30000,
  },
}
